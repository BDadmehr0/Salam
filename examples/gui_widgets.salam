// Official 0.6.18: use C for native page lowering (#3671) and pass the repository
// root, not its std directory, for layout schema discovery (#3687).
// salam run --backend=c --ui=native --stdlib-path="$PWD" examples/gui_widgets.salam
mut count := 0

page:
    include = "../std/gui/widgets/widgets.salam"
    title = "شمارنده"
    lang = "farsi"
    dir = "right to left"
    Surface:
        Card: title = "شمارندهٔ من"
            WidgetLabel: text = "تعداد: " + count end
            ActionButton:
                name = "add"
                caption = "یکی اضافه کن"
                pressed = (): count++ println count end
            end
        end
    end
end
