// Official 0.6.18 needs the C backend for native page lowering (fixed upstream in #3671).
// salam run --backend=c --ui=native --stdlib-path="$PWD/std" examples/gui_widgets.salam
mut count := 0

page:
    include = "../std/gui/widgets/widgets.salam"
    title = "شمارنده"
    lang = "farsi"
    dir = "right to left"
    Surface:
        Card: title = "شمارندهٔ من"
            WidgetLabel: text = "تعداد: " + count end
            ActionButton:
                name = "add"
                caption = "یکی اضافه کن"
                pressed = (): count++ println count end
            end
        end
    end
end
