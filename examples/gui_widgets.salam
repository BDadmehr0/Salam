// salam run --ui=native examples/gui_widgets.salam --stdlib-path="$PWD/std"
component Counter:
    count := 0
    Card: title = "شمارندهٔ من"
        Label: text = "تعداد: " + count end
        ActionButton:
            name = "add"
            caption = "یکی اضافه کن"
            pressed = (): count++ println count end
        end
    end
end

page:
    include = "../std/gui/widgets/widgets.salam"
    title = "شمارنده"
    lang = "farsi"
    dir = "right to left"
    Surface:
        Counter: end
    end
end
